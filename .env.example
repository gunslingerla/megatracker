# Copy to .env.local for local dev, and set these in the Vercel project settings.
# Never commit real values.

# --- Airtable ---
AIRTABLE_TOKEN=            # Airtable Personal Access Token (server-only). Required.
AIRTABLE_BASE=app8R88gFzgjBftgo   # Optional; defaults to this in api/_airtable.js.

# --- Auth ---
APP_PASSWORD=             # Shared band password for login. If blank, the app is open.
AUTH_SECRET=             # Long random string. Signs the login cookie AND share-link tokens. Required.

# --- Dropbox (song bounces) ---
# Preferred: refresh-token flow (tokens auto-refresh).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Or a single long-lived token instead of the three above:
# DROPBOX_TOKEN=
# Optional folder config (see api/_dropbox.js):
# DROPBOX_FOLDER_PATH=
# DROPBOX_SHARED_LINK=

# --- Calendar feed (optional) ---
CAL_FEED_KEY=            # If set, required as ?key= on the /api/calendar.ics feed.

# --- Google Calendar sync (optional; see README "Google Calendar sync") ---
# GOOGLE_SERVICE_ACCOUNT_JSON=   # whole service-account key file contents
# GOOGLE_CALENDAR_ID=            # the calendar to write into (shared with the service account)
# GOOGLE_CALENDAR_TZ=America/Los_Angeles
